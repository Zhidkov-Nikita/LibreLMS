<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — LibreLMS Administration</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <header class="admin-header">
        <div class="container-fluid d-flex align-items-center justify-content-between">
            <a href="/Admin" class="text-white text-decoration-none fs-4 fw-semibold">LibreLMS Administration</a>
            <span class="text-white-50 small">v1.0</span>
        </div>
    </header>

    <div class="container-fluid">
        <div class="row">
            <aside class="col-12 col-md-2 admin-sidebar p-0">
                <nav class="p-3">
                    <h6 class="sidebar-heading">DATA</h6>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a href="/Admin/Students" class="nav-link @(Context.Request.Path.StartsWithSegments("/Admin/Students") ? "active" : "")">Students</a>
                        </li>
                    </ul>
                    <h6 class="sidebar-heading mt-4">ACTIONS</h6>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a href="/Admin/Students/Edit" class="nav-link">+ Add Student</a>
                        </li>
                    </ul>
                </nav>
            </aside>
            <main class="col-12 col-md-10 admin-content p-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
