@page "/Admin/Students"
@model IndexModel
@{
    ViewData["Title"] = "Select students to change";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Students</h2>
    <a href="/Admin/Students/Edit" class="btn btn-sm admin-btn">+ Add Student</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="search" class="form-control form-control-sm" placeholder="Search by name / email"
               value="@Model.SearchTerm" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-outline-secondary">Search</button>
        <a href="/Admin/Students" class="btn btn-sm btn-outline-secondary">Clear</a>
    </div>
</form>

@if (Model.Students.Count == 0)
{
    <div class="alert alert-info">No students found.</div>
}
else
{
    <table class="table admin-table">
        <thead>
            <tr>
                <th><input type="checkbox" id="select-all" /></th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Email</th>
                <th>Enrollment Date</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model.Students)
            {
                <tr>
                    <td><input type="checkbox" class="row-checkbox" value="@s.Id" /></td>
                    <td>@s.FirstName</td>
                    <td>@s.LastName</td>
                    <td><a href="mailto:@s.Email">@s.Email</a></td>
                    <td>@s.EnrollmentDate.ToString("yyyy-MM-dd")</td>
                    <td class="text-end">
                        <a href="/Admin/Students/Edit?id=@s.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a href="/Admin/Students/Delete?id=@s.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <nav>
        <ul class="pagination pagination-sm">
            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="/Admin/Students?page=@i&search=@Model.SearchTerm">@i</a>
                </li>
            }
        </ul>
    </nav>
}

@section Scripts {
    <script>
        document.getElementById('select-all')?.addEventListener('change', function () {
            document.querySelectorAll('.row-checkbox').forEach(cb => cb.checked = this.checked);
        });
    </script>
}
