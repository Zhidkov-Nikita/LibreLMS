@page "/Admin/Students/Delete"
@model DeleteModel
@{
    ViewData["Title"] = "Confirm delete";
}

@if (Model.Student is null)
{
    <div class="alert alert-danger">Student not found.</div>
    <a href="/Admin/Students" class="btn btn-outline-secondary">Back to list</a>
}
else if (Model.Deleted)
{
    <div class="alert alert-success">Student "@Model.Student.FullName" was deleted successfully.</div>
    <a href="/Admin/Students" class="btn btn-outline-secondary">Back to list</a>
}
else
{
    <h2>Are you sure?</h2>

    <p class="text-muted">
        Delete student <strong>@Model.Student.FullName</strong> (@Model.Student.Email)?
    </p>

    <table class="table admin-table mb-4">
        <tr><th>Field</th><th>Value</th></tr>
        <tr><td>Id</td><td>@Model.Student.Id</td></tr>
        <tr><td>First Name</td><td>@Model.Student.FirstName</td></tr>
        <tr><td>Last Name</td><td>@Model.Student.LastName</td></tr>
        <tr><td>Email</td><td>@Model.Student.Email</td></tr>
        <tr><td>Enrollment Date</td><td>@Model.Student.EnrollmentDate.ToString("yyyy-MM-dd")</td></tr>
    </table>

    <form method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Student.Id" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Yes, delete</button>
            <a href="/Admin/Students" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
}
